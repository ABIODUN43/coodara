# ==============================================================================
# Coodara V1 Production Environment Configuration Reference
# ==============================================================================

# Application
APP_NAME=Coodara
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/coodara

# Redis (Celery Broker & Application Cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900
CELERY_WORKER_CONCURRENCY=2

# Authentication & Sessions
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback

# GitHub Token Encryption (Fernet 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# AI & LLM Provider Configuration
# Supported providers: openai | gemini | anthropic | coodara (native reasoning engine)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3
AI_ALLOW_FALLBACK=true

# Analysis Engine Limits
ANALYSIS_MAX_REPO_SIZE_BYTES=262144000
ANALYSIS_MAX_FILE_SIZE_BYTES=5242880
ANALYSIS_MAX_FILES_COUNT=15000
ANALYSIS_TIMEOUT_SECONDS=600
